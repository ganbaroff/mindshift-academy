# MindShift Academy — environment variables.
# Copy to `.env.local` and fill in. Values here are PLACEHOLDERS, not real secrets.
# [REQUIRED] / [REQUIRED IN PROD] / [OPTIONAL] mark the consequence of leaving it unset.

# --- Auth: Clerk [REQUIRED] ---
# Without these the Clerk middleware/provider can't authenticate; gated routes 401.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Database: Turso / libSQL [REQUIRED IN PROD] ---
# If TURSO_DATABASE_URL is unset the app falls back to a LOCAL file:./dev.db. In
# production that is a per-lambda ephemeral SQLite, wiped on cold start = child
# progress does NOT persist. The app now FAILS CLOSED (throws on boot) in prod
# without this. Provision a DB at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- LLM: NVIDIA NIM [REQUIRED for chat] ---
# Powers the tutor reply, the LLM comprehension judge, and classifier moderation.
# Without it the chat degrades to offline keyword checks.
NVIDIA_API_KEY=nvapi-xxx

# --- Image + TTS: OpenAI [OPTIONAL] ---
# Without it: monster art degrades to an emoji-SVG card and /api/tts returns 503
# (client falls back to robotic Web Speech).
OPENAI_API_KEY=sk-xxx

# --- Rate limiting: Upstash Redis [REQUIRED IN PROD] ---
# Without it, the 4 LLM-cost endpoints (chat/monster/tts/generate-silhouette)
# fail closed with 503 in production.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Cron auth [REQUIRED for cron routes] ---
# Without it /api/cron/* fail OPEN (no auth). Pass it as a Bearer token.
CRON_SECRET=your-strong-cron-secret

# --- Email: Resend [OPTIONAL] ---
RESEND_API_KEY=re_xxx

# --- Access allowlist [OPTIONAL] ---
# Comma-separated emails allowed past the onboarding/lesson gate.
ALLOWLIST_EMAILS=parent@example.com,teacher@example.com
