# MindShift Academy — environment variables.
# Copy to `.env.local` and fill in. Values here are PLACEHOLDERS, not real secrets.
# [REQUIRED] / [REQUIRED IN PROD] / [OPTIONAL] mark the consequence of leaving it unset.

# --- Auth: Clerk [REQUIRED] ---
# Without these the Clerk middleware/provider can't authenticate; gated routes 401.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Required in production: generic Clerk JS script from the verified Frontend API domain.
NEXT_PUBLIC_CLERK_JS_URL=https://clerk.volaura.app/npm/@clerk/clerk-js@6/dist/clerk.browser.js

# --- Database: Turso / libSQL [REQUIRED IN PROD] ---
# If TURSO_DATABASE_URL is unset the app falls back to a LOCAL file:./dev.db. In
# production that is a per-lambda ephemeral SQLite, wiped on cold start = child
# progress does NOT persist. The app now FAILS CLOSED (throws on boot) in prod
# without this. Provision a DB at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- LLM safety: NVIDIA NIM [REQUIRED IN PROD] ---
# Powers the preferred Llama Guard safety classifier. Gemini is the independent safety
# fallback; chat remains fail-closed if the required classifiers cannot answer.
NVIDIA_API_KEY=nvapi-xxx

# --- LLM tutor: Azure OpenAI [REQUIRED IN PROD] ---
# Powers the child-facing GPT tutor and lesson judge. KEY2 is only for key rotation; do not
# set it unless Azure has issued a second active key. The deployment name is configured in Azure.
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_OPENAI_KEY2=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your_gpt_deployment
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Image + TTS: OpenAI [OPTIONAL] ---
# Without it: monster art degrades to an emoji-SVG card and /api/tts returns 503
# (client falls back to robotic Web Speech).
OPENAI_API_KEY=sk-xxx

# --- Rate limiting: Upstash Redis [REQUIRED IN PROD] ---
# Without it, the 4 LLM-cost endpoints (chat/monster/tts/generate-silhouette)
# fail closed with 503 in production.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Cron auth [REQUIRED for cron routes] ---
# Without it /api/cron/* fail OPEN (no auth). Pass it as a Bearer token.
CRON_SECRET=your-strong-cron-secret

# --- Email: Resend [OPTIONAL] ---
RESEND_API_KEY=re_xxx

# --- Parent access allowlist [REQUIRED in production] ---
# Legacy bulk list. It remains supported, but do not download and rewrite it
# just to add one parent.
ALLOWLIST_EMAILS=parent@example.com,teacher@example.com
# Preferred additive grant: create one Vercel variable per parent, whose name
# is ACADEMY_ALLOW_EMAIL_<UPPERCASE_SHA256(normalized-email)> and value is 1.
# See docs/PARENT-ACCESS-RUNBOOK.md. The digest avoids raw email in the env
# variable name; it is not a password or encryption.

# --- Added 2026-07-18: complete the env contract (audit P2-CONFIG-007) ---

# AI safety fallback. GEMINI_API_KEY drives kidNet and the strict Gemini fallback used when
# NVIDIA is unavailable. It is independent from the Azure GPT tutor and remains required in prod.
GEMINI_API_KEY=your_gemini_api_key

# Prisma CLI datasource (local dev / migrations only). RUNTIME uses the Turso libSQL adapter
# via TURSO_DATABASE_URL + TURSO_AUTH_TOKEN (above); this is only for the `prisma` CLI/sqlite.
DATABASE_URL=file:./dev.db

# COPPA consent hardening (optional, STRONGLY recommended in prod): server-side pepper mixed
# into the HMAC of the 6-digit email code so a DB leak alone can't brute-force the code space.
CONSENT_CODE_PEPPER=some_long_random_server_side_secret

# Sender for the parental-consent email. Defaults to onboarding@resend.dev if unset — set a
# verified-domain sender in production. Live delivery needs RESEND_API_KEY (above).
RESEND_FROM=MindShift Academy <onboarding@yourdomain.com>

# Clerk routing — must match the app routes so sign-in/up and post-auth redirects land in the
# child flow. FALLBACK_REDIRECT_URL is where a freshly-authenticated user is sent.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Absolute app origin — used to build parent activation links (/activate?t=...) in the
# one-time child-access-code flow (scripts/generate-access-codes.mjs). No secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NOTE: CONSENT_CODE_PEPPER (above) now also peppers AccessCode / activation-token hashes.

# --- Atlas learning adapter (Sprint 2 pilot) [REQUIRED for /api/learning/* live cycle] ---
# Shared file-exchange directory between VOLAURA and Atlas CLI (`atlas learning drain`).
ATLAS_LEARNING_EXCHANGE_DIR=/tmp/atlas-learning-exchange
# Absolute path to atlas-cli dist/cli.js (built from feat/learning-sprint1).
ATLAS_CLI_JS=/path/to/atlas-cli/dist/cli.js
