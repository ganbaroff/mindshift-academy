generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(uuid())
  clerkId       String?  @unique // Clerk auth ID
  username      String   @unique @default("Uchenik")
  xp            Int      @default(0)
  crystals      Int      @default(0)
  streak        Int      @default(0)
  streakFreezes Int      @default(0) // Monetization hook
  lastActive    DateTime @default(now())
  activeStep    Int      @default(1)
  createdAt     DateTime @default(now())

  monster   Monster?
  progress  LessonProgress[]
  inventory Inventory[]
  conceptMasteries   ConceptMastery[]
  atlasLearningSessions AtlasLearningSession[]
  taskAttempts       TaskAttempt[]
  reportDeliveryLogs ReportDeliveryLog[]
  sessionCosts       SessionCost[]
  /// Optional parent-set certificate display label (max 32, filtered). Never logged/metrics.
  certificateDisplayLabel String?
  formulationSubmissions FormulationSubmission[]
  certificate            Certificate?
}

model Monster {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @unique
  name       String
  emoji      String
  color      String
  promptUsed String
  imageUrl   String   @default("")
  mood       Int      @default(100) // Drops if user misses a day (Loss Aversion)
  createdAt  DateTime @default(now())
}

model Inventory {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  itemType   String // "skin", "background", "gacha_ticket"
  itemId     String // "cyber_visor"
  acquiredAt DateTime @default(now())

  @@unique([userId, itemId])
}

model Lesson {
  id          String   @id @default(uuid())
  title       String
  description String
  order       Int      @unique
  xpReward    Int      @default(100)
  crystalRwd  Int      @default(10)
  createdAt   DateTime @default(now())

  progress LessonProgress[]
}

model LessonProgress {
  id          String    @id @default(uuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  completed   Boolean   @default(false)
  score       Int       @default(0)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

// COPPA parental-consent record (docs/COPPA-CONSENT-SPEC.md §4). One row per account
// (clerkId @unique). Valid consent = verifiedAt!=null AND serviceConsent AND
// externalAiConsent AND revokedAt==null AND consentVersion current. The consent RESOLVER
// (src/lib/consent.ts hasValidConsent) is FAIL-CLOSED: any error / missing field => blocked.
// externalAiConsent is a SEPARATE explicit opt-in to the NVIDIA/Google external-AI flow
// (§2) — email-plus alone is not adequate for third-party disclosure, so we take it apart.
model ParentalConsent {
  id                String    @id @default(cuid())
  clerkId           String    @unique // the account this consent covers
  parentEmail       String
  method            String    @default("email-plus")
  serviceConsent    Boolean   @default(false) // opt-in (A): collect/use child data for tutoring
  externalAiConsent Boolean   @default(false) // opt-in (B): the NVIDIA/Google external-AI disclosure
  consentVersion    String // e.g. "2026-06-28" — re-prompt when policy changes
  ipAddress         String?
  verifiedAt        DateTime? // set when the emailed code is confirmed
  revokedAt         DateTime? // set on parent revoke — immediately blocks chat
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Short-TTL email-verification store (§3 step 3, §4 note). We NEVER store the raw 6-digit
// code — only an HMAC-SHA256 hash with a per-row random salt. 15-min expiry, single-use
// (consumedAt), attempt-capped (attempts) to bound brute force of the small code space.
// One pending verification per account (clerkId @unique) — a re-request upserts/overwrites.
model ConsentVerification {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  parentEmail String
  codeHash    String // HMAC-SHA256(code, salt) — raw code is NEVER persisted
  salt        String // per-row random salt for the hash
  expiresAt   DateTime // createdAt + 15 min
  consumedAt  DateTime? // single-use: set the moment a code verifies
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
}

// IDEMPOTENCY: the reward write increments xp/crystals, which double-awards on any
// client retry (network hiccup, double-tap, F5-and-resend). Each lesson-completion
// carries a client-generated UUID; we record it here BEFORE awarding. The @unique
// eventId means a replayed eventId hits P2002 on create, so the award is skipped.
model RewardEvent {
  eventId   String   @id
  userId    String
  stepId    Int
  createdAt DateTime @default(now())
}

// VOLAURA-owned concept mastery (Atlas receives snapshots only).
model ConceptMastery {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept      String
  mastery      Float     @default(0)
  /// Leitner-style step: 0 = due now / shortest interval.
  intervalStep Int       @default(0)
  nextReviewAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, concept])
}

/// One deterministic task attempt. Never stores the child's utterance (COPPA).
model TaskAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept   String
  family    String
  tier      Int
  pass      Boolean
  /// Client idempotency key — replay awards nothing twice.
  eventId   String?  @unique
  /// Additive W2: curriculum session id for resume derivation (nullable for legacy rows).
  sessionId String?
  /// Additive W2: curriculum task id for resume derivation (nullable for legacy rows).
  taskId    String?
  createdAt DateTime @default(now())

  @@index([userId, concept])
  @@index([userId, sessionId])
}

/// Pseudonymous session-scoped AI-degrade event (Section 3A.2).
/// Forbidden: child text, prompts, AI responses, Clerk ID, IP, fingerprints, precise timestamps.
model DegradeEvent {
  id                  String   @id @default(cuid())
  eventId             String   @unique
  opaqueSessionId     String
  lessonId            String
  providerStage       String
  causeEnum           String
  occurredDayBucket   String
  resolvedByFallback  Boolean
  retentionUntil      DateTime
}

/// Parent report delivery outcome — no child text.
model ReportDeliveryLog {
  id         String   @id @default(cuid())
  clerkId    String
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  ok         Boolean
  errorClass String?
  createdAt  DateTime @default(now())

  @@index([clerkId])
}

/// Per-session token/cost meter — zero free text.
model SessionCost {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String
  promptTokens Int      @default(0)
  completionTokens Int  @default(0)
  costMicros   Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([userId, sessionId])
  @@index([userId])
}

/// Own-words formulation SUBMITTED metadata only — NEVER raw child text (Section 3A.3).
model FormulationSubmission {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String
  contentVersion String
  dayBucket      String
  complete       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([userId, sessionId])
  @@index([userId])
}

/// Issued certificate — unique non-derivable id; no public verification page.
model Certificate {
  id               String   @id
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Printed recipient label (default or filtered parent display label).
  recipientLabel   String
  formulationVersion String
  formulationDayBucket String
  issuedDayBucket  String
  createdAt        DateTime @default(now())
}

// Atlas NBA session audit — decision metadata stored in VOLAURA, not Atlas.
model AtlasLearningSession {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept            String
  idempotencyKey     String    @unique
  requestId          String
  decisionId         String?
  goalId             String?
  decisionScore      Float?
  action             String?
  lessonFormat       String?
  masteryBefore      Float
  masteryAfter       Float?
  decideReceiptJson  String?
  outcomeReceiptJson String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
}

// One-time child-access code (docs/superpowers/specs/2026-07-19-child-async-access-design.md).
// Lifecycle: issued -> (parent activates: find/create Clerk user + record consent) active
//   -> (child redeems: mint sign-in ticket) redeemed. Raw code & raw activation token are
// NEVER stored — only HMAC-SHA256(value, salt + CONSENT_CODE_PEPPER) digests. Both digests are
// @unique so a lookup is an indexed point-read and a duplicate can't silently coexist.
model AccessCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique // HMAC of the kid-facing code
  salt                String
  issuedForEmail      String // allowlisted parent email this code authorizes
  status              String    @default("issued") // issued | active | redeemed | revoked
  clerkId             String? // set at activation (find-or-create Clerk user)
  activationTokenHash String    @unique // HMAC of the parent activation-link token
  activationSalt      String
  serviceConsent      Boolean   @default(false) // captured at activation
  externalAiConsent   Boolean   @default(false)
  consentIp           String?
  activatedAt         DateTime?
  redeemedAt          DateTime?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
}
