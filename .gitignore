# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# clerk configuration (can include secrets)
/.clerk/

# local sqlite dev database (child-linked rows — never commit)
/dev.db
/prisma/dev.db
*.db
!.env.example

.vercel

# E2E test-run screenshots (regenerated each run)
scripts/e2e/*.png

# Installed agent skills (dev tooling, regenerable)
.claude/skills/

# Isolated Codex implementation worktrees
/.worktrees/

# Local subagent ledgers and unpublished gate receipts
/.superpowers/sdd/

# Local CI crystal harness DB
ci-crystals*.db

# W0 drill ephemeral outputs
docs/release/_w0_drill_workspace/*.out.txt
# W2 drill ephemeral outputs
docs/release/_w2_drill_workspace/*.out.txt
docs/release/_w2_drill_workspace/*.db
docs/release/_w2_drill_workspace/drill-console.log
# W3 drill ephemeral outputs
docs/release/_w3_drill_workspace/*.out.txt
docs/release/_w3_drill_workspace/*.db
docs/release/_w3_drill_workspace/drill-console.log
# W4 drill ephemeral outputs
docs/release/_w4_drill_workspace/*.out.txt
docs/release/_w4_drill_workspace/*.db
docs/release/_w4_drill_workspace/drill-console.log

/preview.db
/preview.db-shm
/preview.db-wal
/family-codes-*.txt
/invite-preview-*.html
/public/_invite-preview.html
/clerk-prod-config.json

# Screenshots produced by test:map — evidence, not source.
/evidence/

# Drift check scratch dir for `npm run vault:check`.
/.vault-check/
